# frozen_string_literal: true

source 'https://rubygems.org'

gem 'concurrent-ruby', '1.3.4'
gem 'image_processing', RUBY_VERSION >= '3.0' ? '~> 2.0' : '~> 1.2'
gem 'mini_magick'
gem 'minitest', '~> 5.0'
gem 'net-smtp', require: false if RUBY_VERSION >= '3.1'
gem 'puma'
gem 'rails', '~> 6.1.0'
gem 'ruby-vips', '>= 2.0.17', '< 3'
gem 'sqlite3', '~> 1.4'

gemspec path: '../'
